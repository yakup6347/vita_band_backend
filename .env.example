# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Connection String (Prisma format)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/vita_band_db"

# JWT Authentication
JWT_SECRET="vita_band_jwt_secret_key_change_this_in_production"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="*"
