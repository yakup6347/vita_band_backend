# Sunucu Yapılandırması
PORT=5000
NODE_ENV=development

# MySQL Veritabanı Bağlantı Bilgileri
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=vita_band_db

# JWT Güvenlik Ayarları
JWT_SECRET=vita_band_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*
